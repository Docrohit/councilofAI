PORT=4310
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4310
# local permits loopback Ollama/vLLM. hosted permits only the provider origins below.
DEPLOYMENT_MODE=local
ALLOW_SIGNUP=true
# In hosted mode set a 64-character hex key: openssl rand -hex 32
# COUNCIL_ENCRYPTION_KEY=
# ALLOWED_PROVIDER_ORIGINS=https://api.openai.com,https://api.anthropic.com,https://api.z.ai,https://api.deepseek.com
# COOKIE_SECURE=true
# TRUST_PROXY=1
# INVITE_CODE=optional-private-beta-code
# Hosted billing:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=cosmicwisdomyt@gmail.com
# SMTP_PASS=google-app-password
# SMTP_FROM=cosmicwisdomyt@gmail.com
# BUSINESS_EMAIL=cosmicwisdomyt@gmail.com
# BILLING_ADMIN_EMAILS=cosmicwisdomyt@gmail.com,rohitsharma9000@gmail.com
# FREE_MESSAGE_LIMIT=10
# PAYMENT_SATOSHIS=100000
# BILLING_PERIOD_MONTHS=3
# TOKEN_BUDGET_MARGIN_PERCENT=25
# Optional fixed display override; omit for live Coinbase BTC-USD spot lookup.
# BTC_USD_PRICE=
# LIGHTNING_WALLET=your-lightning-invoice-or-address
# Automatic payments (see README): a Lightning address and/or a bitcoin address.
# LIGHTNING_ADDRESS=you@walletofsatoshi.com
# ONCHAIN_ADDRESS=bc1q...
# ONCHAIN_OFFSET_MIN=2001
# ONCHAIN_OFFSET_MAX=3999
# Amounts the other app on the same address uses (Council Network); never handed out here.
# ONCHAIN_RESERVED_BANDS=100001-101999,300001-301999
# ONCHAIN_CONFIRMATIONS=1
# MEMPOOL_API=https://mempool.space/api
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
