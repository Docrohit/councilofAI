[Unit]
Description=Council ephemeral project sandbox broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=councilofai
WorkingDirectory=/srv/councilofai/current
RuntimeDirectory=council-sandbox
RuntimeDirectoryMode=0750
Environment=COUNCIL_SANDBOX_SOCKET=/run/council-sandbox/broker.sock
ExecStart=/usr/bin/node deploy/sandbox-broker.mjs
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/council-sandbox
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
